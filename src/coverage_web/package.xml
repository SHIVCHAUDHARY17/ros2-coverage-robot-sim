<?xml version="1.0"?>
<package format="3">
  <name>coverage_web</name>
  <version>0.1.0</version>
  <description>Operator web UI (FastAPI + WebSocket): start/pause/e-stop, live coverage map and status</description>
  <maintainer email="shivchaudhary1716j@gmail.com">Shiv Jayant Chaudhary</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-httpx</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
