<?xml version="1.0"?>
<package format="3">
  <name>coverage_perception</name>
  <version>0.1.0</version>
  <description>Classical-CV perception: finds the spray-painted removal area in an image and publishes it as the robot's target grid</description>
  <maintainer email="shivchaudhary1716j@gmail.com">Shiv Jayant Chaudhary</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
